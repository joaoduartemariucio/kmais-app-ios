# SwiftFormat — https://github.com/nicklockwood/SwiftFormat
# Defaults are the community baseline; the options below only pin what the defaults leave
# open and keep SwiftFormat and SwiftLint from fighting each other.

--swift-version 6.2
--language-mode 5
--exclude DerivedData,build,.build

# Layout
--indent 4
--max-width 120
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--closing-paren balanced
--wrap-conditions after-first
--wrap-return-type preserve

# SwiftLint's trailing_comma rule forbids trailing commas, so never add them.
--trailing-commas never

# Style
--self remove
--import-grouping testable-last
--header strip
--strip-unused-args closure-only
--type-blank-lines preserve

--decimal-grouping 3,4
--ranges no-space

--enable isEmpty
--enable redundantProperty
--enable sortSwitchCases
--disable wrapMultilineStatementBraces
--disable redundantType

# Rules added as defaults in recent SwiftFormat releases that are not community consensus yet:
# they force one-line bodies onto several lines or rename tests to raw identifiers.
--disable wrapPropertyBodies,wrapFunctionBodies,wrapIfStatementBodies,wrapIfExpressionBodies
--disable swiftTestingTestCaseNames
# Rewrites `!` as `#require(...)`, which the compiler flags as redundant for non-optional
# overloads such as `Decimal(string:)` in test literals.
--disable noForceUnwrapInTests
